# Existing console secrets (generate unique random values; never commit real values).
X_CONSOLE_ADMIN_PASSWORD=replace-in-/etc-only
X_CONSOLE_SESSION_SECRET=replace-with-random-secret
X_CONSOLE_WORKER_SECRET=replace-with-random-secret

# Loopback-only X write service BFF connection.
X_CONSOLE_XWRITE_URL=http://127.0.0.1:8791
X_CONSOLE_XWRITE_SECRET=replace-with-the-same-internal-hmac-secret

# Enable only when a trusted HTTPS terminator is the public entry point.
# This makes the admin session cookie Secure and emits HSTS.
X_CONSOLE_SECURE_COOKIE=1

# Small in-memory abuse limits for unauthenticated endpoints.
X_CONSOLE_LOGIN_RATE_LIMIT=10
X_CONSOLE_LOGIN_RATE_WINDOW=300
X_CONSOLE_OAUTH_RATE_LIMIT=60
X_CONSOLE_OAUTH_RATE_WINDOW=60
