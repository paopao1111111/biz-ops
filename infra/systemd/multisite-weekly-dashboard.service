[Unit]
Description=Multisite Weekly Dashboard Web
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cloudcli
Group=cloudcli-agents
WorkingDirectory=/opt/multisite-dashboard
EnvironmentFile=/etc/multisite-weekly-dashboard.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3.11 /opt/multisite-dashboard/app.py
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/multisite-weekly-dashboard

[Install]
WantedBy=multi-user.target
