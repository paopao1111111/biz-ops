[Unit]
Description=X HTTPS Gateway (8443 -> 8790) with Let's Encrypt IP cert
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3.11 /opt/x-browse-console/x_https_gateway.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/letsencrypt

[Install]
WantedBy=multi-user.target
